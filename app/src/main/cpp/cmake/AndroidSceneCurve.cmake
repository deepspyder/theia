# R07 extends the Android staging tree, never either desktop checkout.
function(theia_android_scene_curve engine_dir)
    set(owned "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../scene_curve")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${owned}/SceneCurveParams.cpp.in" "${owned}/SceneCurveNode.cpp.in")

    file(READ "${engine_dir}/src/core/params.hpp" source)
    set(before "    SceneLatitudeParams scene_latitude;")
    theia_f14_replace(source "${before}" "${before}\n    std::string scene_curve; // Empty is a structural no-op." "scene curve camera state")
    set(before "bool is_known_camera_filter(const std::string& name);")
    theia_f14_replace(source "${before}" "${before}\nbool parse_scene_curve(const std::string&, std::vector<float>&, size_t&, std::string&);" "scene curve parser declaration")
    theia_f14_write("${engine_dir}/src/core/params.hpp" "${source}")

    file(READ "${engine_dir}/src/core/params.cpp" source)
    set(before "    {\"camera_filter\",            \"camera.filter\",                         S, SHOOT, false, 0, 0, false},")
    theia_f14_replace(source "${before}" "${before}\n    {\"scene_curve\", \"camera.scene_curve\", S, SHOOT, false, 0, 0, false}," "scene curve shoot schema")
    set(before "    if (path == \"camera.filter\") return &p.camera.filter;")
    theia_f14_replace(source "${before}" "${before}\n    if (path == \"camera.scene_curve\") return &p.camera.scene_curve;" "scene curve string slot")
    set(before "        if (f->has_range) {")
    set(after "        if (kv.first == \"scene_curve\") {\n            std::vector<float> table; size_t samples = 0;\n            if (!parse_scene_curve(v.as_string(), table, samples, error)) { param = kv.first; return false; }\n        }\n${before}")
    theia_f14_replace(source "${before}" "${after}" "scene curve validation")
    theia_f14_write("${engine_dir}/src/core/params.cpp" "${source}")

    file(READ "${engine_dir}/src/pipeline/pipeline.hpp" source)
    set(before "    bool scene_latitude_wanted() const;")
    theia_f14_replace(source "${before}" "${before}\n    bool scene_curve_wanted() const;\n    bool node_scene_curve(const Image&, Image&, std::string&);" "scene curve pipeline declarations")
    theia_f14_write("${engine_dir}/src/pipeline/pipeline.hpp" "${source}")
    file(READ "${engine_dir}/src/pipeline/pipeline.cpp" source)
    set(before "    node_count_ += scene_latitude_wanted() ? 1 : 0;                      // RFC-023")
    theia_f14_replace(source "${before}" "${before}\n    node_count_ += scene_curve_wanted() ? 1 : 0;" "scene curve progress")
    set(before "    if (scene_latitude_wanted()) { SPK_NODE(node_scene_latitude(cur, next, error)); cur = next; }")
    theia_f14_replace(source "${before}" "${before}\n    if (scene_curve_wanted()) { SPK_NODE(node_scene_curve(cur, next, error)); cur = next; }" "scene curve after latitude before upsample")
    theia_f14_write("${engine_dir}/src/pipeline/pipeline.cpp" "${source}")

    file(READ "${engine_dir}/src/pipeline/engine.cpp" source)
    set(before "    p.camera.scene_latitude.active = false;")
    theia_f14_replace(source "${before}" "${before}\n    p.camera.scene_curve.clear(); // The medium probe must not include the user's scene edit." "scene curve excludes medium probe")
    theia_f14_write("${engine_dir}/src/pipeline/engine.cpp" "${source}")
    file(READ "${engine_dir}/src/gpu/vulkan_gpu.cpp" source)
    set(before "    {\"spk_scene_latitude\", 4, kWorkgroup},")
    theia_f14_replace(source "${before}" "${before}\n    {\"spk_scene_curve\", 5, kWorkgroup}," "scene curve Vulkan bindings")
    theia_f14_write("${engine_dir}/src/gpu/vulkan_gpu.cpp" "${source}")

    configure_file("${owned}/../shaders/vulkan/spk_scene_curve.comp"
        "${engine_dir}/src/shaders/vulkan/spk_scene_curve.comp" COPYONLY)
    file(READ "${owned}/SceneCurveParams.cpp.in" parser)
    theia_f14_write("${engine_dir}/src/core/scene_curve_android.cpp" "${parser}")
    file(READ "${owned}/SceneCurveNode.cpp.in" node)
    theia_f14_write("${engine_dir}/src/pipeline/scene_curve_android.cpp" "${node}")
endfunction()
